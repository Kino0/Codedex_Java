// Add your class here! 💖
 class MusicDownloader {
     String songName;
     String artistName;
     String album;
     String fileLink;
     int releaseYear;

    public MusicDownloader(String songName, String artistName, String album, String fileLink, int releaseYear){
    this.songName = songName;
    this.artistName = artistName;
    this.album = album;
    this.fileLink = fileLink;
    this.releaseYear = releaseYear;
};

public void showFileLink(String songName){
    if (this.songName.trim().equalsIgnoreCase(songName.trim())){
        System.out.println("Link for " + songName + " is: " + fileLink);
        } else {
            System.out.println("Please inform the correct song. (Spaces included)");
        }
    };
};
